      "sentences": [
        {
          "sid": "weather-t1-s01",
          "c": "今日天氣好熱。",
          "j": "gam1 jat6 tin1 hei3 hou2 jit6.",
          "e": "The weather today is very hot.",
          "note": "天氣 (tin1 hei3) is \"weather\". Describe it with 好 (hou2) \"very\" + an adjective — 好熱 (hou2 jit6) \"very hot\", 好凍 (hou2 dung3) \"very cold\". 熱 (jit6) and 凍 (dung3) are the hot/cold pair.",
          "bd": [
            {
              "c": "今日",
              "j": "gam1 jat6",
              "e": "today"
            },
            {
              "c": "天氣",
              "j": "tin1 hei3",
              "e": "weather"
            },
            {
              "c": "好熱",
              "j": "hou2 jit6",
              "e": "very hot"
            }
          ]
        },
        {
          "sid": "weather-t1-s02",
          "c": "落雨喇，帶遮啦。",
          "j": "lok6 jyu5 laa3, daai3 ze1 laa1.",
          "e": "It's raining, bring an umbrella.",
          "note": "落雨 (lok6 jyu5) is \"to rain\" — literally \"fall rain\" (Mandarin uses 下雨). And 遮 (ze1) is the everyday Cantonese for \"umbrella\" (not 雨傘). The 喇 (laa3) marks the change (\"it's raining now\"); 啦 (laa1) nudges (\"bring one\").",
          "bd": [
            {
              "c": "落雨",
              "j": "lok6 jyu5",
              "e": "raining"
            },
            {
              "c": "喇",
              "j": "laa3",
              "e": "(particle - now)"
            },
            {
              "c": "帶",
              "j": "daai3",
              "e": "bring"
            },
            {
              "c": "遮",
              "j": "ze1",
              "e": "umbrella"
            },
            {
              "c": "啦",
              "j": "laa1",
              "e": "(softening particle)"
            }
          ]
        },
        {
          "sid": "weather-t1-s03",
          "c": "颱風嚟喇！",
          "j": "toi4 fung1 lai4 laa3!",
          "e": "The typhoon is coming!",
          "note": "颱風 (toi4 fung1) \"typhoon\" — a big deal in Hong Kong, where a T8 signal usually means no work or school. 嚟喇 (lai4 laa3) \"is coming (now)\" pairs 嚟 (lai4) \"come\" with the change-of-state 喇 (laa3).",
          "bd": [
            {
              "c": "颱風",
              "j": "toi4 fung1",
              "e": "typhoon"
            },
            {
              "c": "嚟",
              "j": "lai4",
              "e": "is coming"
            },
            {
              "c": "喇",
              "j": "laa3",
              "e": "(particle - now)"
            }
          ]
        },
        {
          "sid": "weather-t1-s04",
          "c": "今日好凍，著多件。",
          "j": "gam1 jat6 hou2 dung3, zoek3 do1 gin6.",
          "e": "It's cold today, wear extra layers.",
          "note": "著多件 (zoek3 do1 gin6) is \"wear one more (layer)\" — 著 (zoek3) \"wear\", 多 (do1) \"more\", 件 (gin6) the clothing classifier, with 衫 (saam1) \"top\" left unsaid. Cantonese happily drops an obvious noun.",
          "bd": [
            {
              "c": "今日",
              "j": "gam1 jat6",
              "e": "today"
            },
            {
              "c": "好凍",
              "j": "hou2 dung3",
              "e": "very cold"
            },
            {
              "c": "著",
              "j": "zoek3",
              "e": "wear"
            },
            {
              "c": "多件",
              "j": "do1 gin6",
              "e": "more (items)"
            }
          ]
        },
        {
          "sid": "weather-t1-s05",
          "c": "太陽好猛！",
          "j": "taai3 joeng4 hou2 maang5!",
          "e": "The sun is so strong!",
          "note": "猛 (maang5) means \"strong / fierce / intense\" — 太陽好猛 (taai3 joeng4 hou2 maang5) \"the sun is really strong\". Used for sun, fire, and forceful things (you wouldn't use it for, say, strong coffee).",
          "bd": [
            {
              "c": "太陽",
              "j": "taai3 joeng4",
              "e": "sun"
            },
            {
              "c": "好猛",
              "j": "hou2 maang5",
              "e": "very strong / intense"
            }
          ]
        }
      ],
