      "sentences": [
        {
          "sid": "food-t1-s01",
          "c": "我想飲茶。",
          "j": "ngo5 soeng2 jam2 caa4.",
          "e": "I want to drink tea.",
          "note": "飲 (jam2) is the verb for drinking (Mandarin uses 喝). Note 飲茶 (jam2 caa4), literally \"drink tea\", is also the name for going out for dim sum — \"yum cha\". 想 (soeng2) here is the gentle \"want to\", softer than the blunt 要 (jiu3).",
          "bd": [
            {
              "c": "我",
              "j": "ngo5",
              "e": "I"
            },
            {
              "c": "想",
              "j": "soeng2",
              "e": "want to"
            },
            {
              "c": "飲",
              "j": "jam2",
              "e": "drink"
            },
            {
              "c": "茶",
              "j": "caa4",
              "e": "tea"
            }
          ]
        },
        {
          "sid": "food-t1-s02",
          "c": "呢個飯好味！",
          "j": "ni1 go3 faan6 hou2 mei6!",
          "e": "This rice is delicious!",
          "note": "好味 (hou2 mei6), literally \"good taste\", is the everyday \"delicious / tasty\". And 飯 (faan6) means \"cooked rice\" but stretches to a meal in general — 食飯 (sik6 faan6) is just \"to eat\".",
          "bd": [
            {
              "c": "呢個",
              "j": "ni1 go3",
              "e": "this"
            },
            {
              "c": "飯",
              "j": "faan6",
              "e": "rice / meal"
            },
            {
              "c": "好味",
              "j": "hou2 mei6",
              "e": "delicious"
            }
          ]
        },
        {
          "sid": "food-t1-s03",
          "c": "我好餓，想食麵。",
          "j": "ngo5 hou2 ngo6, soeng2 sik6 min6.",
          "e": "I'm hungry, I want noodles.",
          "note": "餓 (ngo6) \"hungry\" behaves like an adjective — 好餓 (hou2 ngo6) \"very hungry\". And 食 (sik6) is the Cantonese \"to eat\" (Mandarin uses 吃 hek3).",
          "bd": [
            {
              "c": "我",
              "j": "ngo5",
              "e": "I"
            },
            {
              "c": "好餓",
              "j": "hou2 ngo6",
              "e": "very hungry"
            },
            {
              "c": "想食",
              "j": "soeng2 sik6",
              "e": "want to eat"
            },
            {
              "c": "麵",
              "j": "min6",
              "e": "noodles"
            }
          ]
        },
        {
          "sid": "food-t1-s04",
          "c": "佢鍾意食魚。",
          "j": "keoi5 zung1 ji3 sik6 jyu2.",
          "e": "He likes eating fish.",
          "note": "鍾意 (zung1 ji3) is the everyday \"to like\" — put any thing, person, or activity straight after it: 鍾意食魚 (zung1 ji3 sik6 jyu2) \"like eating fish\". (Mandarin's 喜歡 is rare in Cantonese speech.)",
          "bd": [
            {
              "c": "佢",
              "j": "keoi5",
              "e": "he / she"
            },
            {
              "c": "鍾意",
              "j": "zung1 ji3",
              "e": "likes"
            },
            {
              "c": "食",
              "j": "sik6",
              "e": "eat"
            },
            {
              "c": "魚",
              "j": "jyu2",
              "e": "fish"
            }
          ]
        },
        {
          "sid": "food-t1-s05",
          "c": "咖啡同水，唔該。",
          "j": "gaa3 fe1 tung4 seoi2, m4 goi1.",
          "e": "Coffee and water, please.",
          "note": "同 (tung4) links two things as \"and\" — 咖啡同水 (gaa3 fe1 tung4 seoi2) \"coffee and water\". It also means \"with\" — 同我一齊 (tung4 ngo5 jat1 cai4) \"together with me\". Ending with 唔該 (m4 goi1) is the polite \"please\" when ordering.",
          "bd": [
            {
              "c": "咖啡",
              "j": "gaa3 fe1",
              "e": "coffee"
            },
            {
              "c": "同",
              "j": "tung4",
              "e": "and"
            },
            {
              "c": "水",
              "j": "seoi2",
              "e": "water"
            },
            {
              "c": "唔該",
              "j": "m4 goi1",
              "e": "please"
            }
          ]
        }
      ],
