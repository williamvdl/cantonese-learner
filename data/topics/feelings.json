              "c": "好細心",
              "j": "hou2 sai3 sam1",
              "e": "very thorough"
            },
            {
              "c": "所以",
              "j": "so2 ji5",
              "e": "so"
            },
            {
              "c": "做嘢",
              "j": "zou6 je5",
              "e": "do things"
