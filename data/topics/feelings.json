        {
          "sid": "feelings-t1-s01",
          "c": "我好開心！",
          "j": "ngo5 hou2 hoi1 sam1!",
          "e": "I'm very happy!",
          "note": "開心 (hoi1 sam1), literally \"open heart\", is the everyday \"happy\". Many Cantonese feelings are built on 心 (sam1) \"heart\" — 開心 happy, 傷心 (soeng1 sam1) sad, 擔心 (daam1 sam1) worried.",
          "bd": [
            {
              "c": "我",
              "j": "ngo5",
              "e": "I"
            },
            {
              "c": "好",
              "j": "hou2",
              "e": "very"
            },
            {
              "c": "開心",
              "j": "hoi1 sam1",
              "e": "happy"
            }
          ]
        },
        {
          "sid": "feelings-t1-s02",
          "c": "佢好攰。",
          "j": "keoi5 hou2 gui6.",
          "e": "He's very tired.",
          "note": "攰 (gui6) is the Cantonese word for \"tired / worn out\" — 好攰 (hou2 gui6) \"very tired\". A distinctively Cantonese character you won't meet in Mandarin.",
          "bd": [
            {
              "c": "佢",
              "j": "keoi5",
              "e": "he / she"
            },
            {
              "c": "好",
              "j": "hou2",
              "e": "very"
            },
            {
              "c": "攰",
              "j": "gui6",
              "e": "tired"
            }
          ]
        },
        {
          "sid": "feelings-t1-s03",
          "c": "唔好擔心！",
          "j": "m4 hou2 daam1 sam1!",
          "e": "Don't worry!",
          "note": "唔好 (m4 hou2), literally \"not good\", is how Cantonese says \"don't ___\" — 唔好擔心 (m4 hou2 daam1 sam1) \"don't worry\", 唔好走 (m4 hou2 zau2) \"don't go\". 擔心 (daam1 sam1) is \"to worry\".",
          "bd": [
            {
              "c": "唔好",
              "j": "m4 hou2",
              "e": "don't"
            },
            {
              "c": "擔心",
              "j": "daam1 sam1",
              "e": "worry"
            }
          ]
        },
        {
