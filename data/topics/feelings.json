      "sentences": [
        {
          "sid": "feelings-t2-s06",
          "c": "佢好善良，成日幫人。",
          "j": "keoi5 hou2 sin6 loeng4, sing4 jat6 bong1 jan4.",
          "e": "She is very kind — always helping others.",
          "note": "善良 (sin6 loeng4) \"kind / good-natured\" and <b>友善</b> (jau5 sin6) \"friendly\" are close but distinct — 善良 (sin6 loeng4) is deeper moral goodness; 友善 (jau5 sin6) is outward warmth toward others. Both use 善 (sin6) \"good/kind\".",
          "bd": [
            {
              "c": "佢",
              "j": "keoi5",
              "e": "she"
            },
            {
              "c": "好善良",
              "j": "hou2 sin6 loeng4",
              "e": "very kind"
            },
            {
              "c": "成日",
              "j": "sing4 jat6",
              "e": "always"
            },
            {
              "c": "幫人",
              "j": "bong1 jan4",
              "e": "help others"
            }
          ]
        },
        {
          "sid": "feelings-t2-s07",
          "c": "雖然佢有啲懶，但係真係好搞笑。",
          "j": "seoi1 jin4 keoi5 jau5 di1 laan5, daan6 hai6 zan1 hai6 hou2 gaau2 siu3.",
          "e": "Although he is a bit lazy, he is genuinely hilarious.",
          "note": "To describe people, wrap adjectives in 雖然…但係 (seoi1 jin4…daan6 hai6) to give a balanced view — acknowledging a flaw before a strength. 搞笑 (gaau2 siu3) \"funny/hilarious\" is informal and colloquial, stronger than just 好笑 (hou2 siu3).",
          "bd": [
            {
              "c": "雖然",
              "j": "seoi1 jin4",
              "e": "although"
            },
            {
              "c": "有啲懶",
              "j": "jau5 di1 laan5",
              "e": "a bit lazy"
            },
            {
              "c": "但係",
              "j": "daan6 hai6",
              "e": "but"
            },
            {
              "c": "真係",
              "j": "zan1 hai6",
              "e": "genuinely"
            },
            {
              "c": "好搞笑",
              "j": "hou2 gaau2 siu3",
              "e": "hilarious"
            }
          ]
        },
        {
          "sid": "feelings-t2-s08",
          "c": "我細佬好聰明，而且好勤力。",
          "j": "ngo5 sai3 lou2 hou2 cung1 ming4, ji4 ce2 hou2 kan4 lik6.",
          "e": "My younger brother is smart, and what's more, hardworking.",
          "bd": [
            {
              "c": "我細佬",
              "j": "ngo5 sai3 lou2",
              "e": "my younger brother"
            },
            {
              "c": "好聰明",
              "j": "hou2 cung1 ming4",
              "e": "very smart"
            },
            {
              "c": "而且",
              "j": "ji4 ce2",
              "e": "moreover"
            },
            {
              "c": "好勤力",
              "j": "hou2 kan4 lik6",
              "e": "very hardworking"
            }
          ]
        },
        {
          "sid": "feelings-t2-s09",
          "c": "我有啲怕醜，唔係好識同人傾偈。",
          "j": "ngo5 jau5 di1 paa3 cau2, m4 hai6 hou2 sik1 tung4 jan4 king1 gai2.",
          "e": "I'm a bit shy — not great at chatting with people.",
          "note": "<b>怕醜</b> (paa3 cau2) \"shy\" — literally \"scared of embarrassment\". A very natural Cantonese word for shyness or social anxiety. More colloquial and warmer than 內向 (noi6 joeng3) \"introverted\".",
          "bd": [
            {
              "c": "我",
              "j": "ngo5",
              "e": "I"
            },
            {
              "c": "有啲怕醜",
              "j": "jau5 di1 paa3 cau2",
              "e": "a bit shy"
            },
            {
              "c": "唔係好識",
              "j": "m4 hai6 hou2 sik1",
              "e": "not great at"
            },
            {
              "c": "同人傾偈",
              "j": "tung4 jan4 king1 gai2",
              "e": "chatting with people"
            }
          ]
        },
        {
          "sid": "feelings-t2-s10",
          "c": "因為佢好細心，所以做嘢做得好好。",
          "j": "jan1 wai6 keoi5 hou2 sai3 sam1, so2 ji5 zou6 je5 zou6 dak1 hou2 hou2.",
          "e": "Because she is so thorough, she does everything really well.",
          "bd": [
            {
              "c": "因為",
