      "sentences": [
        {
          "sid": "body-t2-s06",
          "c": "我頭痛，而且有啲發燒。",
          "j": "ngo5 tau4 tung3, ji4 ce2 jau5 di1 faat3 siu1.",
          "e": "I have a headache, and also a slight fever.",
          "note": "Add a body part before <b>痛</b> (tung3) \"pain/ache\" to name any ache: 頭痛 (tau4 tung3) \"headache\", 肚痛 (tou5 tung3) \"stomachache\", 喉嚨痛 (hau4 lung4 tung3) \"sore throat\". The pattern is body part + 痛 (tung3).",
          "bd": [
            {
              "c": "我",
              "j": "ngo5",
              "e": "I"
            },
            {
              "c": "頭痛",
              "j": "tau4 tung3",
              "e": "headache"
            },
            {
              "c": "而且",
              "j": "ji4 ce2",
              "e": "and also"
            },
            {
              "c": "有啲發燒",
              "j": "jau5 di1 faat3 siu1",
              "e": "a slight fever"
            }
          ]
        },
        {
          "sid": "body-t2-s07",
          "c": "如果你唔舒服，最好去睇醫生。",
          "j": "jyu4 gwo2 nei5 m4 syu1 fuk6, zeoi3 hou2 heoi3 tai2 ji1 sang1.",
          "e": "If you're not well, best to see a doctor.",
          "note": "睇醫生 (tai2 ji1 sang1) \"see a doctor\" vs 去醫院 (heoi3 ji1 jyun2) \"go to hospital\" — in Hong Kong you'd usually 睇醫生 (tai2 ji1 sang1) at a clinic first; <b>醫院</b> (ji1 jyun2) is for emergencies or serious illness.",
          "bd": [
            {
              "c": "如果",
              "j": "jyu4 gwo2",
              "e": "if"
            },
            {
              "c": "唔舒服",
              "j": "m4 syu1 fuk6",
              "e": "not well"
            },
            {
              "c": "最好",
              "j": "zeoi3 hou2",
              "e": "best to"
            },
            {
              "c": "去睇醫生",
              "j": "heoi3 tai2 ji1 sang1",
              "e": "see a doctor"
            }
          ]
        },
        {
          "sid": "body-t2-s08",
          "c": "因為佢病咗，所以唔可以返工。",
          "j": "jan1 wai6 keoi5 beng6 zo2, so2 ji5 m4 ho2 ji5 faan1 gung1.",
          "e": "Because she is sick, she can't go to work.",
          "bd": [
            {
              "c": "因為",
              "j": "jan1 wai6",
              "e": "because"
            },
            {
              "c": "病咗",
              "j": "beng6 zo2",
              "e": "got sick"
            },
            {
              "c": "所以",
              "j": "so2 ji5",
              "e": "so"
            },
            {
              "c": "唔可以",
              "j": "m4 ho2 ji5",
              "e": "can't"
            },
            {
              "c": "返工",
              "j": "faan1 gung1",
              "e": "go to work"
            }
          ]
        },
        {
          "sid": "body-t2-s09",
          "c": "醫生叫我食藥，一日三次。",
          "j": "ji1 sang1 giu3 ngo5 sik6 joek6, jat1 jat6 saam1 ci3.",
          "e": "The doctor told me to take medicine, three times a day.",
          "note": "食藥 (sik6 joek6) \"take medicine\" — Cantonese uses 食 (sik6) \"eat\" for taking medicine, not a separate verb. The standard dose instruction: 一日三次 (jat1 jat6 saam1 ci3) \"three times a day\".",
          "bd": [
            {
              "c": "醫生",
              "j": "ji1 sang1",
              "e": "doctor"
            },
            {
              "c": "叫我",
              "j": "giu3 ngo5",
              "e": "told me"
            },
            {
              "c": "食藥",
              "j": "sik6 joek6",
              "e": "take medicine"
            },
            {
              "c": "一日三次",
              "j": "jat1 jat6 saam1 ci3",
              "e": "three times a day"
            }
          ]
        },
        {
          "sid": "body-t2-s10",
          "c": "雖然我咳，但係冇發燒。",
          "j": "seoi1 jin4 ngo5 kat1, daan6 hai6 mou5 faat3 siu1.",
          "e": "Although I'm coughing, I don't have a fever.",
          "bd": [
            {
              "c": "雖然",
              "j": "seoi1 jin4",
              "e": "although"
            },
            {
              "c": "我咳",
              "j": "ngo5 kat1",
              "e": "I'm coughing"
            },
            {
              "c": "但係",
              "j": "daan6 hai6",
              "e": "but"
            },
            {
              "c": "冇發燒",
              "j": "mou5 faat3 siu1",
              "e": "no fever"
            }
          ]
        },
        {
          "sid": "body-t2-s11",
          "c": "藥房就喺醫院隔離，好方便。",
          "j": "joek6 fong2 zau6 hai2 ji1 jyun2 gaak3 lei4, hou2 fong1 bin6.",
          "e": "The pharmacy is right next to the hospital — very convenient.",
          "note": "藥房 (joek6 fong2) \"pharmacy\" — in Hong Kong, many minor ailments are handled at the 藥房 (joek6 fong2) without seeing a doctor. The pharmacist (<b>藥劑師</b> joek6 zai1 si1) can advise on common symptoms and sell most over-the-counter medicines.",
          "bd": [
            {
              "c": "藥房",
              "j": "joek6 fong2",
              "e": "pharmacy"
            },
            {
              "c": "就喺",
              "j": "zau6 hai2",
              "e": "is right at"
            },
            {
              "c": "醫院",
              "j": "ji1 jyun2",
              "e": "hospital"
            },
            {
              "c": "隔離",
              "j": "gaak3 lei4",
              "e": "next to"
            },
            {
              "c": "好方便",
              "j": "hou2 fong1 bin6",
              "e": "very convenient"
            }
          ]
        },
        {
          "sid": "body-t2-s12",
          "c": "我肚痛，不如唔好食咁多宵夜。",
          "j": "ngo5 tou5 tung3, bat1 jyu4 m4 hou2 sik6 gam3 do1 siu1 je2.",
          "e": "I have a stomachache — maybe I shouldn't eat so much late-night food.",
          "bd": [
            {
              "c": "我",
              "j": "ngo5",
              "e": "I"
            },
            {
              "c": "肚痛",
              "j": "tou5 tung3",
              "e": "stomachache"
            },
            {
              "c": "不如",
              "j": "bat1 jyu4",
              "e": "how about"
