  "rounds": {
    "1": {
      "note": "Question words in Cantonese usually sit where the answer would go: 'who is going?' becomes <em>bin1 go3 heoi3?</em> — literally 'who go?'. To form a yes/no question, add <strong>maa3</strong> to the end of any statement. To ask 'why', put <strong>dim2 gaai2</strong> at the start. The particle <strong>ne1</strong> attaches to a noun or pronoun to mean 'and you?' / 'what about X?' — a tiny but very useful word for keeping conversation flowing.",
      "words": [
        {
          "id": "questions-001",
          "c": "邊個",
          "j": "bin1 go3",
          "e": "Who"
        },
        {
          "id": "questions-002",
          "c": "乜嘢",
          "j": "mat1 je5",
          "e": "What"
        },
