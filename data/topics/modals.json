      "sentences": [
        {
          "sid": "modals-t2-s01",
          "c": "你可唔可以唔該幫我一陣？",
          "j": "nei5 ho2 m4 ho2 ji5 m4 goi1 bong1 ngo5 jat1 zan6?",
          "e": "Could you please help me for a moment?",
          "note": "可唔可以 (ho2 m4 ho2 ji5) is the A-not-A question form of 可以 (ho2 ji5) — the standard polite way to make a request. Paired with 唔該 (m4 goi1) it becomes extra-polite.",
          "bd": [
            {
              "c": "你",
              "j": "nei5",
              "e": "you"
            },
            {
              "c": "可唔可以",
              "j": "ho2 m4 ho2 ji5",
              "e": "could you / can or can't you"
            },
            {
              "c": "唔該",
              "j": "m4 goi1",
              "e": "please"
            },
            {
              "c": "幫我",
              "j": "bong1 ngo5",
              "e": "help me"
            },
            {
              "c": "一陣",
              "j": "jat1 zan6",
              "e": "a moment"
            }
          ]
        },
        {
          "sid": "modals-t2-s02",
          "c": "媽媽唔俾我出去，所以我要留係屋企。",
          "j": "maa1 maa1 m4 bei2 ngo5 ceot1 heoi3, so2 ji5 ngo5 jiu3 lau4 hai2 uk1 kei2.",
          "e": "Mum won't let me go out, so I have to stay home.",
          "note": "唔俾 (m4 bei2) + person + verb = won't let [someone] do [something]. Colloquial and personal — 唔俾我出去 (m4 bei2 ngo5 ceot1 heoi3) is what a parent says; contrast 唔准 (m4 zeon2) which is more formal, used by rules or authority.",
          "bd": [
            {
              "c": "媽媽",
              "j": "maa1 maa1",
              "e": "mum"
            },
            {
              "c": "唔俾我",
              "j": "m4 bei2 ngo5",
              "e": "won't let me"
            },
            {
              "c": "出去",
              "j": "ceot1 heoi3",
              "e": "go out"
            },
            {
              "c": "所以",
              "j": "so2 ji5",
              "e": "so"
            },
            {
              "c": "我要",
              "j": "ngo5 jiu3",
              "e": "I have to"
            },
            {
              "c": "留係",
              "j": "lau4 hai2",
              "e": "stay at"
            },
            {
              "c": "屋企",
              "j": "uk1 kei2",
              "e": "home"
            }
          ]
        },
        {
          "sid": "modals-t2-s03",
          "c": "呢度唔准飲食，你唔該注意吓。",
          "j": "ni1 dou6 m4 zeon2 jam2 sik6, nei5 m4 goi1 zyu3 ji3 haa5.",
          "e": "No eating or drinking here, please be mindful.",
          "note": "唔准 (m4 zeon2) is the formal or official prohibition — signs, rules, authority contexts. 唔俾 (m4 bei2) is what a person says to another person; 唔准 (m4 zeon2) is what rules say.",
          "bd": [
            {
              "c": "呢度",
              "j": "ni1 dou6",
              "e": "here"
