      "sentences": [
        {
          "sid": "animals-t1-s01",
          "c": "我屋企有一隻貓。",
          "j": "ngo5 uk1 kei2 jau5 jat1 zek3 maau1.",
          "e": "I have a cat at home.",
          "note": "屋企 (uk1 kei2) is the Cantonese word for \"home\" (Mandarin 家 gaa1). Animals take the classifier 隻 (zek3) — 一隻貓 (jat1 zek3 maau1) \"a cat\", 一隻狗 (jat1 zek3 gau2) \"a dog\".",
          "bd": [
            {
              "c": "我",
              "j": "ngo5",
              "e": "I"
            },
            {
              "c": "屋企",
              "j": "uk1 kei2",
              "e": "home"
            },
            {
              "c": "有",
              "j": "jau5",
              "e": "have"
            },
            {
              "c": "一隻",
              "j": "jat1 zek3",
              "e": "one (animal)"
            },
            {
              "c": "貓",
              "j": "maau1",
              "e": "cat"
            }
          ]
        },
        {
          "sid": "animals-t1-s02",
          "c": "呢隻狗好可愛！",
