            },
            {
              "c": "可愛",
              "j": "ho2 oi3",
              "e": "cute"
            }
          ]
        },
        {
          "sid": "animals-t1-s03",
          "c": "你養唔養寵物？",
          "j": "nei5 joeng5 m4 joeng5 cung2 mat6?",
          "e": "Do you keep pets?",
          "note": "養 (joeng5) means \"to keep / raise\" an animal — 養唔養寵物？(joeng5 m4 joeng5 cung2 mat6?) \"do you keep pets?\". The 養唔養 (joeng5 m4 joeng5) \"keep-not-keep\" shape is the standard yes/no question form.",
          "bd": [
            {
              "c": "你",
              "j": "nei5",
              "e": "you"
            },
            {
              "c": "養唔養",
              "j": "joeng5 m4 joeng5",
              "e": "keep or not (yes/no)"
            },
            {
              "c": "寵物",
              "j": "cung2 mat6",
              "e": "pet"
            }
          ]
        },
        {
          "sid": "animals-t1-s04",
          "c": "我鍾意馬。",
          "j": "ngo5 zung1 ji3 maa5.",
