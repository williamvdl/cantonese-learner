      "sentences": [
        {
          "sid": "directions-t1-s01",
          "c": "轉左。",
          "j": "zyun3 zo2.",
          "e": "Turn left.",
          "note": "轉 (zyun3) is \"to turn\" — 轉左 (zyun3 zo2) \"turn left\", 轉右 (zyun3 jau6) \"turn right\". A bare command, no \"you\" needed. (This 左 zo2 \"left\" sounds exactly like the completed-action 咗 zo2 — different character, same sound.)",
          "bd": [
            {
              "c": "轉",
              "j": "zyun3",
              "e": "turn"
            },
            {
              "c": "左",
              "j": "zo2",
              "e": "left"
            }
          ]
        },
        {
          "sid": "directions-t1-s02",
          "c": "直行就到。",
          "j": "zik6 haang4 zau6 dou3.",
          "e": "Go straight, you'll arrive.",
          "note": "直行 (zik6 haang4) is \"go straight ahead\". 就到 (zau6 dou3) means \"you'll be there / almost there\" — 就 (zau6) is \"then / right away\", a very common little word for \"and then it happens\".",
          "bd": [
            {
              "c": "直行",
              "j": "zik6 haang4",
              "e": "go straight"
            },
            {
              "c": "就",
              "j": "zau6",
              "e": "then"
            },
            {
              "c": "到",
              "j": "dou3",
              "e": "arrive"
            }
          ]
        },
        {
          "sid": "directions-t1-s03",
          "c": "喺前面。",
          "j": "hai2 cin4 min6.",
          "e": "It's ahead.",
          "note": "前面 (cin4 min6) \"ahead / in front\" and 後面 (hau6 min6) \"behind\" use the same 面 (min6) \"side\" suffix as the location words. 喺前面 (hai2 cin4 min6) \"it's ahead\".",
          "bd": [
            {
              "c": "喺",
              "j": "hai2",
              "e": "is at"
            },
            {
              "c": "前面",
              "j": "cin4 min6",
              "e": "ahead / in front"
            }
          ]
        },
        {
          "sid": "directions-t1-s04",
          "c": "好近，行幾分鐘。",
          "j": "hou2 kan5, haang4 gei2 fan1 zung1.",
          "e": "Very close, just a few minutes walk.",
          "note": "近 (kan5) is \"near / close\" (opposite 遠 jyun5 \"far\"). Here 幾 (gei2) means \"a few\" rather than \"how many\" — 行幾分鐘 (haang4 gei2 fan1 zung1) \"walk a few minutes\". 行 (haang4) is \"to walk\".",
          "bd": [
            {
              "c": "好近",
              "j": "hou2 kan5",
              "e": "very close"
            },
            {
              "c": "行",
              "j": "haang4",
              "e": "walk"
            },
            {
              "c": "幾分鐘",
              "j": "gei2 fan1 zung1",
              "e": "a few minutes"
            }
          ]
        },
        {
          "sid": "directions-t1-s05",
          "c": "喺對面。",
          "j": "hai2 deoi3 min6.",
          "e": "It's opposite.",
          "note": "對面 (deoi3 min6) is \"opposite / across the way\" — 喺對面 (hai2 deoi3 min6) \"it's just opposite\". (Don't confuse with 對 deoi3 \"pair\" or 對唔住 deoi3 m4 zyu6 \"sorry\" — same sound, different words.)",
          "bd": [
            {
              "c": "喺",
              "j": "hai2",
              "e": "is at"
            },
            {
              "c": "對面",
              "j": "deoi3 min6",
              "e": "opposite"
            }
          ]
        }
