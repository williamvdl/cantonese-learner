        {
          "sid": "greetings-t2-s06",
          "c": "幸會幸會！好高興認識你。",
          "j": "hang6 wui6 hang6 wui6! hou2 gou1 hing3 jing6 sik1 nei5.",
          "e": "A pleasure! So glad to meet you.",
          "note": "<b>幸會</b> (hang6 wui6) \"a pleasure to meet you\" — more formal than 你好 (nei5 hou2) and reserved for first meetings with someone you respect or have been told about. Often said twice — 幸會幸會 (hang6 wui6 hang6 wui6) — for extra warmth.",
          "bd": [
            {
              "c": "幸會幸會",
              "j": "hang6 wui6 hang6 wui6",
              "e": "a pleasure"
            },
            {
              "c": "好高興",
              "j": "hou2 gou1 hing3",
              "e": "so glad"
            },
            {
              "c": "認識",
              "j": "jing6 sik1",
              "e": "meet/know"
            },
            {
              "c": "你",
              "j": "nei5",
              "e": "you"
            }
          ]
        },
        {
          "sid": "greetings-t2-s07",
          "c": "好耐冇見，你近排點呀？",
          "j": "hou2 noi6 mou5 gin3, nei5 gan6 paai2 dim2 aa3?",
          "e": "Long time no see — how you have been lately?",
          "note": "好耐冇見 (hou2 noi6 mou5 gin3) \"long time no see\" + <b>近排點呀</b> (gan6 paai2 dim2 aa3) \"how you have been lately\" naturally pair up as a reunion greeting. 近排 (gan6 paai2) means \"recently / these days\".",
          "bd": [
