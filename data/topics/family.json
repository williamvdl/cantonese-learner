        {
          "sid": "family-t1-s01",
          "c": "我爸爸好高。",
          "j": "ngo5 baa4 baa1 hou2 gou1.",
          "e": "My father is very tall.",
          "note": "With close family you can drop the 嘅 (ge3) \"'s\" — 我爸爸 (ngo5 baa4 baa1) \"my dad\", not 我嘅爸爸. Note the tone shift in doubled kinship words: 爸爸 is baa4 baa1, the second syllable lifting high — same in 媽媽 (maa4 maa1), 哥哥 (go4 go1).",
          "bd": [
            {
              "c": "我",
              "j": "ngo5",
              "e": "my"
            },
            {
              "c": "爸爸",
              "j": "baa4 baa1",
              "e": "father"
            },
            {
              "c": "好高",
              "j": "hou2 gou1",
              "e": "very tall"
            }
          ]
        },
        {
          "sid": "family-t1-s02",
          "c": "我媽媽係老師。",
          "j": "ngo5 maa4 maa1 hai6 lou5 si1.",
          "e": "My mother is a teacher.",
          "bd": [
            {
              "c": "我",
              "j": "ngo5",
              "e": "my"
            },
            {
              "c": "媽媽",
              "j": "maa4 maa1",
              "e": "mother"
